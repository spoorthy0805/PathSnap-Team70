{
  "protocol": {
    "cv": "GroupKFold(n_splits=5, shuffle=True, random_state=42) by trip",
    "train_trips": 78,
    "excluded_trips": [
      "00000033",
      "00000054"
    ],
    "features": [
      "dist",
      "rank",
      "dist_minus_min",
      "dist_ratio",
      "frac",
      "at_endpoint",
      "n_cands",
      "n_within_radius",
      "min_dist",
      "second_gap",
      "arc_len_log",
      "two_way",
      "out_deg_end",
      "in_deg_start",
      "heading_cos",
      "heading_diff",
      "heading_cos_wide",
      "heading_valid",
      "speed",
      "dt_prev",
      "dt_next",
      "gap_flag",
      "dist_prev1",
      "dist_next1",
      "dist_win5_mean",
      "dist_win5_max"
    ],
    "threshold": 0.5,
    "seed": 42
  },
  "models": {
    "logreg": {
      "family": "Linear",
      "config": {
        "C": 1.0,
        "max_iter": 1000
      },
      "max_train_rows": null,
      "notes": ""
    },
    "gnb": {
      "family": "Probabilistic",
      "config": {
        "var_smoothing": 1e-09
      },
      "max_train_rows": null,
      "notes": ""
    },
    "knn": {
      "family": "Instance-based",
      "config": {
        "n_neighbors": 25,
        "weights": "distance"
      },
      "max_train_rows": 60000,
      "notes": "trained on a 60k-row random subsample (brute-force search cost)"
    },
    "dtree": {
      "family": "Tree",
      "config": {
        "max_depth": 12,
        "min_samples_leaf": 50
      },
      "max_train_rows": null,
      "notes": ""
    },
    "rf": {
      "family": "Ensemble (bagging)",
      "config": {
        "n_estimators": 100,
        "min_samples_leaf": 5,
        "max_features": "sqrt",
        "max_samples": 0.5
      },
      "max_train_rows": null,
      "notes": ""
    },
    "lgbm": {
      "family": "Boosting",
      "config": {
        "n_estimators": 400,
        "learning_rate": 0.05,
        "num_leaves": 63,
        "subsample": 0.8,
        "subsample_freq": 1,
        "colsample_bytree": 0.8
      },
      "max_train_rows": null,
      "notes": ""
    },
    "xgb": {
      "family": "Boosting",
      "config": {
        "n_estimators": 400,
        "learning_rate": 0.05,
        "max_depth": 7,
        "subsample": 0.8,
        "colsample_bytree": 0.8
      },
      "max_train_rows": null,
      "notes": ""
    },
    "mlp": {
      "family": "Neural network",
      "config": {
        "hidden": [
          64,
          32
        ],
        "alpha": 0.0001,
        "lr": 0.001,
        "batch_size": 1024,
        "epochs": 20
      },
      "max_train_rows": null,
      "notes": ""
    }
  }
}